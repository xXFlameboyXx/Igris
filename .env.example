IGRIS_APP_NAME=Igris
IGRIS_ENVIRONMENT=development
IGRIS_LOG_LEVEL=INFO
IGRIS_ENABLE_DOCS=true
IGRIS_METADATA_BACKEND=json
IGRIS_MAX_UPLOAD_BYTES=52428800
IGRIS_SAMPLE_STORAGE_DIR=data/samples
IGRIS_METADATA_STORAGE_FILE=data/metadata/samples.json
IGRIS_SAMPLE_TEMP_DIR=data/tmp
IGRIS_ANALYSIS_TIMEOUT_SECONDS=10
IGRIS_REQUEST_ID_HEADER=X-Request-ID
IGRIS_TRUSTED_PROXY_HEADERS=false

# Example only. Use a local secret manager or deployment secret store for real values.
IGRIS_DATABASE_URL=postgresql://igris:change-me@localhost:5432/igris
